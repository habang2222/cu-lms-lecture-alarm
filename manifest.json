{
  "manifest_version": 3,
  "name": "싸강 완료 알림",
  "version": "2.2.0",
  "key": "",
  "description": "대구가톨릭대학교 iLOS 온라인 강의의 재생 완료를 감지해 Windows 경고창으로 알려줍니다.",
  "permissions": [
    "activeTab",
    "alarms",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://lms.cu.ac.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "싸강 완료 알림",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.cu.ac.kr/*"
      ],
      "js": [
        "logic.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
